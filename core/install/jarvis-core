#!/usr/bin/env bash
# jarvis-core: look after Jarvis Core, the home base's 24/7 system report.
#
#   jarvis-core status               is it running, is everything OK, which addresses
#   jarvis-core url                  the address to paste into Jarvis on the iPhone and the Mac
#   jarvis-core update [--force]     download the latest version, restart, reload the screen
#   jarvis-core restart              restart the Core (the screen reconnects by itself)
#   jarvis-core logs [-f]            the Core's recent log (-f: keep following it)
#   jarvis-core open                 (re)start the full-screen dashboard on this computer's screen
#   jarvis-core autoupdate on|off|status   keep it up to date by itself (every 20 minutes)
#   jarvis-core uninstall [--purge]  remove Jarvis Core; keeps its history unless --purge
#
# Installed by core/install/install.sh as ~/.local/bin/jarvis-core. `jarvis-core screen` is what
# the login autostart runs: it waits for the Core, then starts Chrome full screen.
# `jarvis-core autoupdate-tick` is what the update timer runs: it updates only when GitHub's core/
# folder changed, and goes back to the previous version if the new one doesn't answer 90 s later.
# When it has nothing to update, it tries again the brain's libraries an update couldn't install (at its
# next check, then every 2 hours, less often when the cause isn't the network), restarts the Core to load
# them and keeps them only if it holds up 90 s later, as after an update; otherwise it goes back to the
# previous ones. It leaves them to any other install of them that is running, and a stopped Core alone.
# Test-only overrides: JARVIS_CORE_APP_DIR, JARVIS_CORE_SUDOERS_FILE, JARVIS_CORE_GDM_CONF,
# JARVIS_CORE_SHIM, JARVIS_CORE_PORT, JARVIS_CORE_UPDATE_CHECK_SEC.

set -uo pipefail

PORT="${JARVIS_CORE_PORT:-8788}"
APP_DIR="${JARVIS_CORE_APP_DIR:-$HOME/jarvis-core-app}"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
SELF_BIN="$HOME/.local/bin/jarvis-core"
UNIT_NAME=jarvis-core.service
UNIT_FILE="$CONFIG_HOME/systemd/user/$UNIT_NAME"
AUTOSTART_FILE="$CONFIG_HOME/autostart/jarvis-core-screen.desktop"
PROFILE_DIR="$DATA_HOME/jarvis-core-screen" # Chrome's own profile; "jarvis-core" in the path labels it on the dashboard
DATA_DIR="$DATA_HOME/jarvis-core"
SETTINGS_DIR="$CONFIG_HOME/jarvis-core"
STATE_DIR="$SETTINGS_DIR/install"
LOCAL_URL="http://localhost:$PORT/"
PING_URL="http://127.0.0.1:$PORT/api/ping"
SUDOERS_FILE="${JARVIS_CORE_SUDOERS_FILE:-/etc/sudoers.d/jarvis-core-smartctl}"
GDM_CONF="${JARVIS_CORE_GDM_CONF:-/etc/gdm3/custom.conf}"
SHIM="${JARVIS_CORE_SHIM:-/usr/local/bin/jarvis-core}"
# Automatic updates: the unit names the owner's hand-made timer used (adopted as they are)
AU_SERVICE=jarvis-core-autoupdate.service
AU_TIMER=jarvis-core-autoupdate.timer
AU_SERVICE_FILE="$CONFIG_HOME/systemd/user/$AU_SERVICE"
AU_TIMER_FILE="$CONFIG_HOME/systemd/user/$AU_TIMER"
AU_OLD_SCRIPT="$HOME/.local/bin/jarvis-core-autoupdate" # the hand-made script those units ran
AU_STATE="$STATE_DIR/autoupdate"
AU_LOG="$DATA_DIR/autoupdate.log"
AU_EVENTS="$DATA_DIR/update-events.jsonl" # the Core adds these lines to its event log, then removes the file
AU_CHECK_SEC="${JARVIS_CORE_UPDATE_CHECK_SEC:-90}" # how long a new version gets before it must answer
LIBS_RETRY_SEC=7200 # after a failed try at the brain's libraries, the update timer waits 2 hours for the next
LIBS_WAIT_MAX=86400 # ... doubling after each failure that isn't the network (a full disk), up to a day
LIBS_LOCK="$STATE_DIR/libraries.lock"   # held by whatever installs the brain's libraries (install.sh knows it too)
LIBS_ERROR="$STATE_DIR/libraries-error" # install.sh: why they didn't go in last time (words, then npm's line)

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  B=$'\e[1m' G=$'\e[32m' Y=$'\e[33m' R=$'\e[31m' D=$'\e[2m' N=$'\e[0m'
else
  B='' G='' Y='' R='' D='' N=''
fi
ok() { printf '  %s✓%s %s\n' "$G" "$N" "$*"; }
note() { printf '  %s!%s %s\n' "$Y" "$N" "$*"; }
bad() { printf '  %s✗%s %s\n' "$R" "$N" "$*"; }
say() { printf '    %s\n' "$*"; }
title() { printf '\n%s%s%s\n' "$B" "$*" "$N"; }
die() {
  bad "$*"
  exit 1
}

# ------------------------------------------------------------------------------------------ helpers

have() { command -v "$1" >/dev/null 2>&1; }

http_get() { # URL [timeout seconds]: print the body; fails on errors (never through a proxy)
  if have curl; then
    curl --noproxy '*' -fsS -m "${2:-3}" "$1" 2>/dev/null
  elif have node; then
    node -e 'fetch(process.argv[1], { signal: AbortSignal.timeout(process.argv[2] * 1000) })
      .then(async (r) => { if (!r.ok) process.exit(1); process.stdout.write(await r.text()); })
      .catch(() => process.exit(1));' "$1" "${2:-3}" 2>/dev/null
  else
    return 1
  fi
}

core_up() { http_get "$PING_URL" 2 >/dev/null; }

wait_core() { # seconds: wait until the Core answers
  local i
  for ((i = 0; i < $1; i++)); do
    core_up && return 0
    sleep 1
  done
  return 1
}

json_get() { # json_get a.b.c < json: strings as is, arrays one item a line, objects their keys
  if have node; then
    node -e 'let s = ""; process.stdin.on("data", (d) => (s += d)).on("end", () => {
      let v; try { v = JSON.parse(s); } catch { process.exit(2); }
      for (const k of process.argv[1].split(".").filter(Boolean)) {
        if (v === null || typeof v !== "object") process.exit(1);
        v = v[k];
      }
      if (v === undefined || v === null) process.exit(1);
      if (Array.isArray(v)) v = v.join("\n"); else if (typeof v === "object") v = Object.keys(v).join("\n");
      process.stdout.write(String(v) + "\n");
    });' "$1"
  elif have python3; then
    python3 -I -c 'import json, sys
try:
    v = json.load(sys.stdin)
except Exception:
    sys.exit(2)
for k in [k for k in sys.argv[1].split(".") if k]:
    if not isinstance(v, dict):
        sys.exit(1)
    v = v.get(k)
if v is None:
    sys.exit(1)
if isinstance(v, bool):
    v = "true" if v else "false"
elif isinstance(v, list):
    v = "\n".join(str(x) for x in v)
elif isinstance(v, dict):
    v = "\n".join(v.keys())
print(v)' "$1"
  else
    return 1
  fi
}

user_systemctl() { systemctl --user "$@"; }

ensure_user_bus() { # systemctl --user and gsettings need the session bus, also from ssh
  if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
    XDG_RUNTIME_DIR="/run/user/$(id -u)"
    export XDG_RUNTIME_DIR
  fi
  if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ -S "$XDG_RUNTIME_DIR/bus" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
  fi
}

ensure_graphical_env() { # find the desktop session's display, also when run from ssh or a tty
  ensure_user_bus
  if [ -z "${WAYLAND_DISPLAY:-}" ] && [ -z "${DISPLAY:-}" ]; then
    local line key value
    while IFS= read -r line; do
      key=${line%%=*}
      value=${line#*=}
      case "$key" in
        DISPLAY | WAYLAND_DISPLAY | XAUTHORITY | XDG_SESSION_TYPE | XDG_CURRENT_DESKTOP)
          case "$value" in *[!A-Za-z0-9_.:/@=+-]*) ;; *) export "$key=$value" ;; esac
          ;;
      esac
    done < <(user_systemctl show-environment 2>/dev/null)
  fi
  [ -n "${WAYLAND_DISPLAY:-}" ] || [ -n "${DISPLAY:-}" ]
}

state_get() { # state_get key: a value the installer recorded
  [ -f "$STATE_DIR/state" ] || return 1
  local line
  while IFS= read -r line; do
    case "$line" in "$1="*)
      printf '%s\n' "${line#*=}"
      return 0
      ;;
    esac
  done <"$STATE_DIR/state"
  return 1
}

# The installer's note, the file itself, or sudo asked from a session of its own with no terminal (so a
# password this terminal cached in the last 15 minutes does not count as the rule).
smart_rule_present() {
  [ "$(state_get sudoers 2>/dev/null)" = installed ] || [ -e "$SUDOERS_FILE" ] ||
    { have setsid && setsid -w sudo -n -l /usr/sbin/smartctl -j -H -A -i /dev/sda </dev/null >/dev/null 2>&1; }
}

sudo_ready=0
need_sudo() { # ask for the password once, if there is a terminal to ask in
  [ "$(id -u)" = 0 ] && return 0
  [ "$sudo_ready" = 1 ] && return 0
  if sudo -n true 2>/dev/null; then
    sudo_ready=1
    return 0
  fi
  if (exec </dev/tty) 2>/dev/null; then
    say "This needs your password (the one you log in with). Nothing shows while you type; that's normal."
    if sudo -v; then
      sudo_ready=1
      return 0
    fi
  fi
  return 1
}

as_root() {
  if [ "$(id -u)" = 0 ]; then "$@"; else sudo "$@"; fi
}

# ------------------------------------------------------------------------------------------ Tailscale

TS_BIN=""
TS_JSON=""
ts_load() { # read `tailscale status --json` once; fails when Tailscale is missing or not running
  TS_BIN=$(command -v tailscale 2>/dev/null) || TS_BIN=""
  [ -n "$TS_BIN" ] || return 1
  TS_JSON=$(timeout 10 "$TS_BIN" status --json 2>/dev/null) || TS_JSON=""
  [ -n "$TS_JSON" ]
}
ts_state() { # not-installed | not-running | Running | NeedsLogin | Stopped | ...
  if [ -z "$TS_BIN" ]; then
    echo not-installed
  elif [ -z "$TS_JSON" ]; then
    echo not-running
  else
    printf '%s' "$TS_JSON" | json_get BackendState 2>/dev/null || echo unknown
  fi
}
ts_dns_name() { # this machine's name on the tailnet, without the final dot
  local name
  name=$(printf '%s' "$TS_JSON" | json_get Self.DNSName 2>/dev/null) || return 1
  name=${name%.}
  [ -n "$name" ] && printf '%s\n' "$name"
}
ts_serving() { # true when `tailscale serve` passes HTTPS on to this Core
  [ -n "$TS_BIN" ] || return 1
  timeout 10 "$TS_BIN" serve status --json 2>/dev/null |
    grep -Eq "\"Proxy\": *\"(https?://)?(127\\.0\\.0\\.1|localhost|\\[::1\\])?:?$PORT/?\""
}
ts_url() { # the https address on the tailnet, when serve is set up
  local name
  name=$(ts_dns_name) || return 1
  ts_serving || return 1
  printf 'https://%s/\n' "$name"
}

# ------------------------------------------------------------------------------------------ the screen

chrome_bin() {
  local c
  for c in google-chrome-stable google-chrome chromium chromium-browser; do
    if have "$c"; then
      command -v "$c"
      return 0
    fi
  done
  return 1
}

# Why --app and not --kiosk: an app window is full screen with no tabs or address bar, yet F11
# still leaves full screen, and the dashboard's "Open Jarvis" opens the regular app in a normal
# Chrome window that Ctrl+W closes, back to the dashboard. --kiosk traps the owner (no F11), opens
# Jarvis as an invisible full-screen tab, and can show Chrome's "What's new" tab after an update.
screen_args() {
  # shellcheck disable=SC2054 # the comma in --disable-features is part of one argument
  SCREEN_ARGS=(
    "--user-data-dir=$PROFILE_DIR"
    "--app=$LOCAL_URL"
    --start-fullscreen
    --no-first-run
    --no-default-browser-check
    --password-store=basic # with automatic login, the GNOME keyring would put an unlock dialog over the screen
    --hide-crash-restore-bubble
    --disable-features=Translate,TranslateUI
    --noerrdialogs
  )
}

mark_clean_exit() { # no "Restore pages?" after a power cut, no translate bar, no first-run pages
  mkdir -p "$PROFILE_DIR/Default" || return 1
  : >>"$PROFILE_DIR/First Run"
  have node || return 0
  node -e 'const fs = require("fs");
    const file = process.argv[1];
    let p = {};
    try { p = JSON.parse(fs.readFileSync(file, "utf8")); } catch {}
    if (!p || typeof p !== "object" || Array.isArray(p)) p = {};
    p.profile = Object.assign({}, p.profile, { exit_type: "Normal", exited_cleanly: true });
    p.translate = Object.assign({}, p.translate, { enabled: false });
    p.browser = Object.assign({}, p.browser, { has_seen_welcome_page: true });
    fs.writeFileSync(file + ".jarvis-core.tmp", JSON.stringify(p));
    fs.renameSync(file + ".jarvis-core.tmp", file);' "$PROFILE_DIR/Default/Preferences" 2>/dev/null || true
}

screen_pids() { pgrep -u "$(id -u)" -f -- "--user-data-dir=$PROFILE_DIR( |$)" 2>/dev/null; }
screen_running() { [ -n "$(screen_pids)" ]; }

stop_screen() {
  screen_running || return 0
  pkill -TERM -u "$(id -u)" -f -- "--user-data-dir=$PROFILE_DIR( |$)" 2>/dev/null
  local i
  for ((i = 0; i < 50; i++)); do
    screen_running || return 0
    sleep 0.1
  done
  pkill -KILL -u "$(id -u)" -f -- "--user-data-dir=$PROFILE_DIR( |$)" 2>/dev/null
  sleep 0.5
}

cmd_screen() { # what the login autostart runs: wait for the Core, then Chrome full screen
  local print=0 wait_s=60 arg chrome
  for arg in "$@"; do
    case "$arg" in
      --print-args) print=1 ;;
      --no-wait) wait_s=0 ;;
    esac
  done
  screen_args
  chrome=$(chrome_bin) || chrome=""
  if [ "$print" = 1 ]; then
    printf '%s\n' "${chrome:-google-chrome-stable}" "${SCREEN_ARGS[@]}"
    return 0
  fi
  [ -n "$chrome" ] || {
    echo "jarvis-core: Google Chrome is not installed (https://www.google.com/chrome/)" >&2
    return 1
  }
  # Up to a minute after login for the Core; after that Chrome starts anyway, the dashboard's
  # offline banner shows and it reconnects by itself.
  wait_core "$wait_s" || true
  if screen_running; then
    return 0 # already on the screen
  fi
  mark_clean_exit
  exec "$chrome" "${SCREEN_ARGS[@]}"
}

cmd_open() {
  title "Jarvis Core screen"
  chrome_bin >/dev/null || die "Google Chrome is not installed. Install it from https://www.google.com/chrome/ and run: jarvis-core open"
  ensure_graphical_env || die "No desktop session found. Log in on the computer's screen first, then run: jarvis-core open"
  if screen_running; then
    stop_screen
    ok "Closed the dashboard window"
  fi
  core_up || note "Jarvis Core isn't answering yet; the dashboard will connect as soon as it does (jarvis-core status)."
  if have setsid; then
    setsid -f "$SELF_PATH" screen </dev/null >/dev/null 2>&1
  else
    nohup "$SELF_PATH" screen </dev/null >/dev/null 2>&1 &
  fi
  local i
  for ((i = 0; i < 100; i++)); do
    screen_running && break
    sleep 0.1
  done
  if screen_running; then
    ok "The dashboard is opening full screen. Press F11 to leave full screen, F11 again to go back."
  else
    ok "The dashboard is starting (it waits up to a minute for Jarvis Core)."
  fi
}

# ------------------------------------------------------------------------------------------ status, url

cmd_url() {
  title "Jarvis Core addresses"
  say "On this computer:        $LOCAL_URL"
  ts_load
  local url name
  if url=$(ts_url); then
    say "On your iPhone and Mac:  ${B}${url}${N}"
    say "Paste that into Jarvis on the iPhone and on the Mac: Settings > Home base."
    return 0
  fi
  case "$(ts_state)" in
    not-installed)
      note "Tailscale isn't installed, so your iPhone and Mac can't reach Jarvis Core yet. Run:"
      say "  wget -qO- https://tailscale.com/install.sh | sh"
      say "  sudo tailscale up"
      say "  sudo tailscale serve --bg $PORT"
      ;;
    Running)
      name=$(ts_dns_name) || name=""
      note "Tailscale is on, but it doesn't pass Jarvis Core to your devices yet. Run:"
      say "  sudo tailscale serve --bg $PORT"
      [ -n "$name" ] && say "Then the address will be https://$name/"
      ;;
    *)
      note "Tailscale is installed but not connected. Run:"
      say "  sudo tailscale up"
      say "  sudo tailscale serve --bg $PORT"
      ;;
  esac
  say "Then run: jarvis-core url"
  return 1
}

cmd_status() {
  ensure_user_bus
  title "Jarvis Core"
  local active enabled since status summary level linger
  active=$(user_systemctl is-active "$UNIT_NAME" 2>/dev/null) || true
  enabled=$(user_systemctl is-enabled "$UNIT_NAME" 2>/dev/null) || true
  if [ "$active" = active ]; then
    since=$(user_systemctl show "$UNIT_NAME" -p ActiveEnterTimestamp --value 2>/dev/null) || since=""
    ok "Running${since:+ since $since}"
  elif [ -f "$UNIT_FILE" ]; then
    bad "Not running (${active:-unknown}). Try: jarvis-core restart, then jarvis-core logs"
  else
    bad "Not installed. Run the install command again."
  fi
  if status=$(http_get "http://127.0.0.1:$PORT/api/status" 5); then
    level=$(printf '%s' "$status" | json_get health.level 2>/dev/null) || level=""
    summary=$(printf '%s' "$status" | json_get health.summary 2>/dev/null) || summary=""
    case "$level" in
      ok) ok "Health: $summary" ;;
      warn) note "Health: $summary" ;;
      alert) bad "Health: $summary" ;;
      *) note "Answering, health not known yet" ;;
    esac
  else
    bad "Not answering on $LOCAL_URL"
  fi
  if [ "$enabled" = enabled ]; then
    ok "Starts by itself when the computer starts"
  else
    note "Not set to start by itself (run the install command again)"
  fi
  linger=$(loginctl show-user "$(id -un)" -p Linger --value 2>/dev/null) || linger=""
  [ "$linger" = yes ] || note "Runs only while you're logged in (lingering is off)"
  if au_enabled && [ -f "$AU_TIMER_FILE" ]; then
    ok "Keeps itself up to date (jarvis-core autoupdate status)"
  else
    note "Automatic updates are off (turn them on: jarvis-core autoupdate on)"
  fi
  if [ -d "$APP_DIR/core" ]; then
    # By the lockfile's hash that install.sh writes once npm ci has finished: libraries from an earlier
    # version, kept when an update couldn't install this one's, are out of date, not "installed".
    case "$(libs_state)" in
      ok) ok "The brain's libraries are installed (Claude, notifications and speech)" ;;
      missing)
        note "The brain's libraries are missing, so Claude work, notifications and speech are off."
        say "$(libs_hint)"
        ;;
      stale)
        note "The brain's libraries are out of date (this version needs new ones)."
        say "$(libs_hint)"
        ;;
    esac
  fi
  if screen_running; then
    ok "The dashboard is on the screen"
  elif [ -f "$AUTOSTART_FILE" ]; then
    note "The dashboard isn't on the screen right now (start it: jarvis-core open)"
  fi
  cmd_url || true
  if [ -d "$APP_DIR/.git" ]; then
    local rev when
    rev=$(git -C "$APP_DIR" rev-parse --short HEAD 2>/dev/null) || rev="?"
    when=$(git -C "$APP_DIR" log -1 --format=%cd --date=format:'%d %b %Y' 2>/dev/null) || when=""
    printf '\n    %sVersion %s from %s, in %s%s\n' "$D" "$rev" "$when" "$APP_DIR" "$N"
  fi
}

# ------------------------------------------------------------------------------------------ restart, logs

cmd_restart() {
  ensure_user_bus
  title "Restarting Jarvis Core"
  user_systemctl daemon-reload 2>/dev/null || true
  user_systemctl restart "$UNIT_NAME" || die "Could not restart it. See: jarvis-core logs"
  if wait_core 30; then
    ok "Jarvis Core is running again. The screen reconnects by itself."
  else
    bad "It hasn't answered within 30 seconds. See: jarvis-core logs"
    return 1
  fi
}

cmd_logs() {
  ensure_user_bus
  local follow=()
  case "${1:-}" in -f | --follow) follow=(-f) ;; esac
  journalctl --user -u "$UNIT_NAME" -n 200 --no-pager -o short-iso "${follow[@]}"
}

# ------------------------------------------------------------------------------------------ update

cmd_update() {
  local force=0 arg
  for arg in "$@"; do [ "$arg" = --force ] && force=1; done
  title "Updating Jarvis Core"
  [ -d "$APP_DIR/.git" ] || die "$APP_DIR is missing. Run the install command again."
  local changes before after
  changes=$(git -C "$APP_DIR" status --porcelain --untracked-files=no 2>/dev/null) || changes=""
  before=$(git -C "$APP_DIR" rev-parse HEAD 2>/dev/null) || before=""
  if [ "$force" = 1 ]; then
    local repo branch backup
    repo=$(git -C "$APP_DIR" remote get-url origin 2>/dev/null) || die "No download address in $APP_DIR"
    branch=$(git -C "$APP_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null) || branch=main
    backup="$APP_DIR.old-$(date +%Y%m%d-%H%M%S)"
    mv "$APP_DIR" "$backup" || die "Could not move $APP_DIR aside"
    say "Your previous copy is kept in $backup"
    if ! git clone --quiet --depth 1 --filter=blob:none --sparse --branch "$branch" "$repo" "$APP_DIR" ||
      ! git -C "$APP_DIR" sparse-checkout set core; then
      rm -rf "$APP_DIR"
      mv "$backup" "$APP_DIR"
      die "Could not download a fresh copy (is the internet up?). Nothing changed."
    fi
    ok "Downloaded a fresh copy"
  else
    if [ -n "$changes" ]; then
      bad "Files in $APP_DIR were changed on this computer, so I won't overwrite them:"
      printf '%s\n' "$changes" | sed 's/^/      /'
      say "To keep them, copy them somewhere else first. To replace them with the latest version, run:"
      say "  jarvis-core update --force    (your copy is kept as $APP_DIR.old-<date>)"
      return 1
    fi
    if ! git -C "$APP_DIR" pull --ff-only --quiet; then
      bad "Could not update: the latest version doesn't follow on from this copy (or the internet is down)."
      say "To replace this copy with the latest version, run: jarvis-core update --force"
      return 1
    fi
  fi
  after=$(git -C "$APP_DIR" rev-parse HEAD 2>/dev/null) || after=""
  if [ "$before" = "$after" ]; then
    ok "Already up to date ($(git -C "$APP_DIR" rev-parse --short HEAD 2>/dev/null))"
  else
    ok "Updated to $(git -C "$APP_DIR" rev-parse --short HEAD 2>/dev/null)"
  fi
  # The installer, in refresh mode, rewrites this command, the service and the autostart from the new
  # version, restarts the Core and reloads the screen. No questions, no password.
  exec bash "$APP_DIR/core/install/install.sh" --refresh
}

# ------------------------------------------------------------------------------------------ automatic updates

au_get() { # au_get key: what the update timer last recorded
  [ -f "$AU_STATE" ] || return 1
  local line
  while IFS= read -r line; do
    case "$line" in "$1="*)
      printf '%s\n' "${line#*=}"
      return 0
      ;;
    esac
  done <"$AU_STATE"
  return 1
}

au_set() { # au_set key value
  mkdir -p "$STATE_DIR" || return 1
  local line out=""
  if [ -f "$AU_STATE" ]; then
    while IFS= read -r line; do
      case "$line" in "$1="*) ;; *) out+="$line"$'\n' ;; esac
    done <"$AU_STATE"
  fi
  printf '%s%s=%s\n' "$out" "$1" "$2" >"$AU_STATE.tmp" && mv -f "$AU_STATE.tmp" "$AU_STATE"
}

au_unset() { # au_unset key...
  local key line out="" found=0 drop
  for key in "$@"; do au_get "$key" >/dev/null && found=1; done
  [ "$found" = 1 ] || return 0
  while IFS= read -r line; do
    drop=0
    for key in "$@"; do case "$line" in "$key="*) drop=1 ;; esac; done
    [ "$drop" = 1 ] || out+="$line"$'\n'
  done <"$AU_STATE"
  printf '%s' "$out" >"$AU_STATE.tmp" && mv -f "$AU_STATE.tmp" "$AU_STATE"
}

au_clock() { # epoch seconds -> "Nov 25 3:20 PM"
  date -d "@$1" '+%b %-d %-I:%M %p' 2>/dev/null || printf '%s\n' "$1"
}

# The brain's libraries against this copy's package-lock.json (install.sh writes the lockfile's sha256 into
# node_modules once npm ci has finished there): ok (they match), missing (no node_modules), stale (another
# version's libraries, or not from a finished install), none (no lockfile, so nothing to install).
libs_state() {
  local core="$APP_DIR/core" want have
  [ -f "$core/package-lock.json" ] || { echo none; return 0; }
  [ -d "$core/node_modules" ] || { echo missing; return 0; }
  want=$(sha256sum "$core/package-lock.json" 2>/dev/null) || want=""
  want=${want%% *}
  have=$(cat "$core/node_modules/.jarvis-lock-sha256" 2>/dev/null) || have=""
  if [ -n "$want" ] && [ "$want" = "$have" ]; then echo ok; else echo stale; fi
}

libs_words() { # missing | stale, as the owner reads it
  case "$1" in
    missing) echo "missing" ;;
    *) echo "out of date (this version needs new ones)" ;;
  esac
}

lock_sha() { # the sha256 of this copy's package-lock.json (what install.sh writes into node_modules)
  local s
  s=$(sha256sum "$APP_DIR/core/package-lock.json" 2>/dev/null) || return 1
  printf '%s\n' "${s%% *}"
}

# Another install of the libraries is running right now (jarvis-core update, the installer, or a check). Only a
# file that is there is tried: a status command creates nothing.
libs_busy() { [ -e "$LIBS_LOCK" ] && have flock && ! flock -n "$LIBS_LOCK" true 2>/dev/null; }

# What an install left behind: its staging folder (a check stopped during npm ci), the previous libraries put aside.
libs_leftovers() { [ -e "$APP_DIR/core/.npm-install" ] || [ -e "$APP_DIR/core/node_modules.old" ]; }

libs_error() { # libs_error 1|2: why the last libraries step failed (1: in a few words, 2: npm's own line)
  [ -f "$LIBS_ERROR" ] || return 1
  sed -n "${1}p" "$LIBS_ERROR" 2>/dev/null | head -c 200
}

# The time (epoch seconds) before which the update timer leaves the libraries alone, after its last try failed;
# nothing when its next check tries them. The wait is 2 hours, longer after repeated failures that weren't the
# network (libs_wait). A clock that went back since then counts as due.
libs_retry_after() {
  local failed now wait
  failed=$(au_get libs_failed) || return 0
  case "$failed" in '' | *[!0-9]*) return 0 ;; esac
  wait=$(au_get libs_wait) || wait=""
  case "$wait" in '' | *[!0-9]*) wait=$LIBS_RETRY_SEC ;; esac
  now=$(date +%s)
  if [ "$failed" -le "$now" ] && [ $((now - failed)) -lt "$wait" ]; then
    echo $((failed + wait))
  fi
}

# Systemd isn't running the Core and isn't about to: the owner stopped it (a Core that keeps failing is
# "activating" between its restarts, and counts as running).
core_stopped() {
  local s
  s=$(user_systemctl is-active "$UNIT_NAME" 2>/dev/null) || true
  case "$s" in inactive | failed) return 0 ;; esac
  return 1
}

libs_hint() { # how libraries that aren't right get their next try, in one sentence
  local after failed last="" bad bad_at why sha out
  if ! { au_enabled && [ -f "$AU_TIMER_FILE" ]; }; then
    echo "Install them: jarvis-core update"
    return 0
  fi
  if libs_busy; then
    echo "They are being installed right now."
    return 0
  fi
  sha=$(lock_sha) || sha=""
  if bad=$(au_get libs_bad) && [ -n "$sha" ] && [ "$bad" = "$sha" ]; then
    out="went back to the previous ones"
    [ -d "$APP_DIR/core/node_modules" ] || out="took them out again"
    bad_at=$(au_get libs_bad_at) || bad_at=""
    case "$bad_at" in '' | *[!0-9]*) bad_at="" ;; *) bad_at=" ($(au_clock "$bad_at"))" ;; esac
    echo "This version's new libraries made Jarvis Core fail$bad_at, so it $out; a newer version tries again."
    return 0
  fi
  if core_stopped; then
    echo "Jarvis Core isn't running; the next automatic update check after it starts tries again."
    return 0
  fi
  after=$(libs_retry_after)
  if failed=$(au_get libs_failed); then
    why=$(libs_error 1) || why=""
    case "$failed" in '' | *[!0-9]*) failed="" ;; esac
    # no time from the future after the clock went back
    if [ -n "$failed" ] && [ "$failed" -le "$(date +%s)" ]; then failed=$(au_clock "$failed"); else failed=""; fi
    if [ -n "$failed" ] && [ -n "$why" ]; then
      last="The last try failed ($failed: $why); the"
    elif [ -n "$failed$why" ]; then
      last="The last try failed ($failed$why); the"
    else
      last="The last try failed; the"
    fi
  else
    last="The"
  fi
  if [ -n "$after" ]; then
    echo "$last next automatic update check after $(au_clock "$after") tries again."
  else
    echo "$last next automatic update check tries again."
  fi
}

au_log() { # a line for the journal and for ~/.local/share/jarvis-core/autoupdate.log (its last 500 lines)
  local line n
  line="$(date '+%Y-%m-%d %H:%M:%S') $*"
  printf '%s\n' "$line"
  mkdir -p "$DATA_DIR" 2>/dev/null || return 0
  printf '%s\n' "$line" >>"$AU_LOG" 2>/dev/null || return 0
  n=$(wc -l <"$AU_LOG" 2>/dev/null) || n=0
  if [ "${n:-0}" -gt 600 ]; then
    tail -n 500 "$AU_LOG" >"$AU_LOG.tmp" 2>/dev/null && mv -f "$AU_LOG.tmp" "$AU_LOG"
  fi
}

au_event() { # au_event info|warn core.update|core.rollback MESSAGE: a line for the Core's event log
  local msg=${3//\\/\\\\}
  msg=${msg//\"/\\\"}
  mkdir -p "$DATA_DIR" 2>/dev/null || return 0
  printf '{"t":%s000,"level":"%s","rule":"%s","message":"%s"}\n' "$(date +%s)" "$1" "$2" "$msg" >>"$AU_EVENTS" 2>/dev/null || true
}

# TimeoutStartSec: an update's npm ci (15 min at most), its 90 s check and a rollback's npm ci, plus a wait for a
# libraries install the owner started (jarvis-core update) to finish, all fit in an hour.
au_service_content() {
  printf '%s\n' \
    "# Jarvis Core: looks for a new version on GitHub and installs it when core/ changed; goes back to" \
    "# the previous version if the new one doesn't answer. Installed by jarvis-core autoupdate on;" \
    "# jarvis-core autoupdate off removes it." \
    "[Unit]" \
    "Description=Jarvis Core automatic update check" \
    "" \
    "[Service]" \
    "Type=oneshot" \
    "ExecStart=\"$SELF_BIN\" autoupdate-tick" \
    "TimeoutStartSec=60min" \
    "Nice=10"
}

au_timer_content() {
  printf '%s\n' \
    "# Jarvis Core: when to look for a new version (jarvis-core autoupdate on|off|status)." \
    "[Unit]" \
    "Description=Jarvis Core automatic update check, every 20 minutes" \
    "" \
    "[Timer]" \
    "OnBootSec=5min" \
    "OnUnitActiveSec=20min" \
    "RandomizedDelaySec=60" \
    "" \
    "[Install]" \
    "WantedBy=timers.target"
}

au_write_units() { # true when something changed
  local changed=1 file content
  mkdir -p "$(dirname "$AU_SERVICE_FILE")" || return 2
  for file in "$AU_SERVICE_FILE" "$AU_TIMER_FILE"; do
    if [ "$file" = "$AU_SERVICE_FILE" ]; then content=$(au_service_content); else content=$(au_timer_content); fi
    if [ -f "$file" ] && [ "$(cat "$file" 2>/dev/null)" = "$content" ]; then continue; fi
    printf '%s\n' "$content" >"$file.tmp.$$" && chmod 0644 "$file.tmp.$$" && mv -f "$file.tmp.$$" "$file" || return 2
    changed=0
  done
  return "$changed"
}

au_units_ours() { # both units are this version's
  [ -f "$AU_SERVICE_FILE" ] && [ -f "$AU_TIMER_FILE" ] &&
    [ "$(cat "$AU_SERVICE_FILE")" = "$(au_service_content)" ] && [ "$(cat "$AU_TIMER_FILE")" = "$(au_timer_content)" ]
}

au_enabled() { user_systemctl is-enabled "$AU_TIMER" >/dev/null 2>&1; }

cmd_autoupdate_on() {
  ensure_user_bus
  title "Automatic updates"
  local adopted=0
  if [ -f "$AU_OLD_SCRIPT" ] || { [ -f "$AU_SERVICE_FILE" ] && ! au_units_ours; }; then adopted=1; fi
  au_write_units
  [ $? -eq 2 ] && die "Couldn't write $AU_SERVICE_FILE"
  if [ -f "$AU_OLD_SCRIPT" ]; then
    rm -f "$AU_OLD_SCRIPT"
  fi
  user_systemctl daemon-reload 2>/dev/null || true
  if ! user_systemctl enable --now --quiet "$AU_TIMER" 2>/dev/null; then
    bad "Couldn't turn on the update timer (systemctl --user enable --now $AU_TIMER)"
    return 1
  fi
  [ "$adopted" = 1 ] && ok "Took over the update timer you set up by hand (same names; it now runs jarvis-core autoupdate-tick)"
  ok "On: every 20 minutes Jarvis Core looks for a new version on GitHub and installs it by itself."
  say "If a new version doesn't answer within 90 seconds, it goes back to the one before."
  say "Turn it off: jarvis-core autoupdate off. See what it did: jarvis-core autoupdate status"
}

cmd_autoupdate_off() {
  ensure_user_bus
  title "Automatic updates"
  user_systemctl disable --now --quiet "$AU_TIMER" >/dev/null 2>&1 || true
  user_systemctl stop "$AU_SERVICE" >/dev/null 2>&1 || true
  rm -f "$AU_TIMER_FILE" "$AU_SERVICE_FILE" "$AU_OLD_SCRIPT"
  user_systemctl daemon-reload 2>/dev/null || true
  ok "Off: Jarvis Core no longer updates itself. Get the latest version by hand: jarvis-core update"
}

# What the installer's refresh runs: keeps the units current and takes over hand-made ones; never
# turns automatic updates on by itself.
cmd_autoupdate_refresh() {
  [ -f "$AU_TIMER_FILE" ] || [ -f "$AU_SERVICE_FILE" ] || [ -f "$AU_OLD_SCRIPT" ] || return 0
  ensure_user_bus
  local hand=0 rc
  [ -f "$AU_OLD_SCRIPT" ] && hand=1
  au_write_units
  rc=$?
  [ "$rc" = 2 ] && { note "Couldn't update $AU_SERVICE_FILE"; return 0; }
  rm -f "$AU_OLD_SCRIPT"
  [ "$rc" = 0 ] && user_systemctl daemon-reload 2>/dev/null
  au_enabled || user_systemctl enable --now --quiet "$AU_TIMER" 2>/dev/null || true
  if [ "$hand" = 1 ]; then
    ok "Took over the update timer you set up by hand: it now updates and goes back if a new version fails"
  elif [ "$rc" = 0 ]; then
    ok "Updated the automatic update timer"
  else
    ok "Automatic updates are on"
  fi
}

au_when() { # 2026-11-25T03:20:11-05:00 -> "Nov 25 3:20 AM" (what date can do; else as is)
  date -d "$1" '+%b %-d %-I:%M %p' 2>/dev/null || printf '%s\n' "$1"
}

cmd_autoupdate_status() {
  ensure_user_bus
  title "Automatic updates"
  local v next
  if au_enabled && [ -f "$AU_TIMER_FILE" ]; then
    if au_units_ours; then
      ok "On: every 20 minutes Jarvis Core looks for a new version on GitHub and installs it by itself"
    else
      ok "On, with the timer you set up by hand (jarvis-core autoupdate on takes it over and adds the safety net)"
    fi
    next=$(user_systemctl show "$AU_TIMER" -p NextElapseUSecRealtime --value 2>/dev/null) || next=""
    [ -n "$next" ] && [ "$next" != n/a ] && say "Next check: $next"
  elif [ -f "$AU_TIMER_FILE" ]; then
    note "Set up but not running. Turn it on: jarvis-core autoupdate on"
  else
    note "Off. Turn it on: jarvis-core autoupdate on   (or update by hand: jarvis-core update)"
  fi
  if v=$(au_get last_check); then say "Last check: $(au_when "$v") ($(au_get last_result || echo '?'))"; fi
  if v=$(au_get last_update); then say "Last update: $v"; fi
  if v=$(au_get last_rollback); then note "Went back to the previous version once: $v"; fi
  v=$(libs_state)
  case "$v" in
    missing | stale)
      note "The brain's libraries are $(libs_words "$v")."
      say "$(libs_hint)"
      next=$(libs_error 2) && [ -n "$next" ] && say "npm said: $next"
      ;;
  esac
  [ -f "$AU_LOG" ] && say "Its log: $AU_LOG"
  return 0
}

core_restarts() { user_systemctl show "$UNIT_NAME" -p NRestarts --value 2>/dev/null; }

core_answers() { # three tries, two seconds apart
  local i
  for i in 1 2 3; do
    core_up && return 0
    [ "$i" = 3 ] || sleep 2
  done
  return 1
}

# The Core holds up for AU_CHECK_SEC: it answers at the end, and systemd didn't have to restart it meanwhile.
core_holds_up() {
  local n0 n1
  n0=$(core_restarts) || n0=""
  sleep "$AU_CHECK_SEC"
  n1=$(core_restarts) || n1=""
  case "$n0" in '' | *[!0-9]*) n0=0 n1=0 ;; esac # no restart counter: the answer alone decides
  case "$n1" in '' | *[!0-9]*) n1=$n0 ;; esac
  core_answers && [ "$n1" -le "$n0" ]
}

# The brain's libraries that an update couldn't install (its npm ci failed: no internet, npm's registry down),
# tried again by a check that doesn't update: at the first check after that update, then every LIBS_RETRY_SEC
# while npm can't reach its registry, doubling up to LIBS_WAIT_MAX for other failures (a full disk). It is a
# deployment like an update, so it runs as one transaction under the libraries lock (a running jarvis-core update
# or installer waits for it; when one of them is installing, this check leaves it to them): the installer's
# libraries step puts the new ones in and the previous ones aside, the Core restarts to load them (its brain
# doesn't pick up a Claude SDK that was missing when it started), and they stay only if it holds up as after an
# update. Otherwise the previous ones go back and this lockfile's libraries are left alone until a newer version.
# A try that fails restarts nothing, and a Core the owner stopped is left alone.
au_libs_retry() {
  local st
  st=$(libs_state)
  if { [ "$st" = ok ] || [ "$st" = none ]; } && ! au_get libs_trying >/dev/null && ! libs_leftovers; then
    au_unset libs_failed libs_wait libs_bad libs_bad_at
    return 0
  fi
  if ! have flock || ! { mkdir -p "$STATE_DIR" && : >>"$LIBS_LOCK"; } 2>/dev/null; then
    au_libs_retry_locked
    return 0
  fi
  (
    if ! flock -n 8; then
      echo "The brain's libraries are being installed right now (jarvis-core update?); the next check looks again."
      exit 0
    fi
    au_libs_retry_locked
  ) 8>>"$LIBS_LOCK"
  return 0
}

au_libs_retry_locked() { # holding the libraries lock on fd 8: it goes to install.sh, never to anything that stays
  local st sha trying bad after now rc wait
  st=$(libs_state)
  sha=$(lock_sha) || sha=""
  trying=$(au_get libs_trying) || trying=""
  if [ -n "$trying" ]; then
    if [ "$st" = ok ] && [ "$trying" = "$sha" ]; then
      au_log "The check of the brain's new libraries was cut short: checking them now"
      au_libs_check "$sha"
      return 0
    fi
    au_unset libs_trying
  fi
  case "$st" in
    ok | none)
      rm -rf "$APP_DIR/core/.npm-install" "$APP_DIR/core/node_modules.old" # left by an install that was cut short
      au_unset libs_failed libs_wait libs_bad libs_bad_at
      return 0
      ;;
  esac
  bad=$(au_get libs_bad) || bad=""
  if [ -n "$sha" ] && [ "$bad" = "$sha" ]; then
    echo "The brain's libraries are $(libs_words "$st"): this version's own made Jarvis Core fail, so they wait for a newer version."
    return 0
  fi
  after=$(libs_retry_after)
  if [ -n "$after" ]; then
    echo "The brain's libraries are $(libs_words "$st"): the next try is at the first check after $(au_clock "$after")."
    return 0
  fi
  if core_stopped; then
    echo "The brain's libraries are $(libs_words "$st"), and Jarvis Core isn't running: they wait until it runs again."
    return 0
  fi
  if ! core_answers; then # new libraries can only be checked on a Core that answers now
    echo "The brain's libraries are $(libs_words "$st"), but Jarvis Core isn't answering right now: the next check tries again."
    return 0
  fi
  now=$(date +%s)
  au_log "The brain's libraries are $(libs_words "$st"): installing them again"
  JARVIS_CORE_LIBS_LOCKED=1 bash "$APP_DIR/core/install/install.sh" --libraries --keep-old </dev/null 9>&-
  rc=$?
  if [ "$rc" = 0 ] && [ "$(libs_state)" != ok ]; then rc=1; fi
  case "$rc" in
    0)
      au_unset libs_failed libs_wait
      au_set libs_trying "$sha"
      au_libs_check "$sha"
      ;;
    3) # already in place: whatever put them there (jarvis-core update, the installer) restarts the Core itself
      au_unset libs_failed libs_wait
      au_log "The brain's libraries were already in place (another install put them there)"
      ;;
    4) echo "The brain's libraries are being installed right now (jarvis-core update?); the next check looks again." ;;
    *)
      if [ "$rc" = 5 ]; then # npm couldn't reach its registry: worth trying again soon
        wait=$LIBS_RETRY_SEC
        au_unset libs_wait
      else # a full disk, a broken lockfile, a failing install script: no use trying every 2 hours forever
        wait=$(au_get libs_wait) || wait=""
        case "$wait" in '' | *[!0-9]*) wait=$LIBS_RETRY_SEC ;; *) wait=$((wait * 2)) ;; esac
        [ "$wait" -gt "$LIBS_WAIT_MAX" ] && wait=$LIBS_WAIT_MAX
        au_set libs_wait "$wait"
      fi
      au_set libs_failed "$now"
      au_set last_result "the brain's libraries didn't install"
      au_log "The brain's libraries still didn't install; the next try is at the first check after $(au_clock $((now + wait)))"
      ;;
  esac
}

# New libraries are in place, the previous ones (if any) in node_modules.old, and libs_trying says so: restart the
# Core to load them and keep them only if it holds up; otherwise put back what was there (nothing, if nothing was)
# and restart. If it answers then, these libraries broke it, and this lockfile's are left alone (libs_bad) until a
# newer version; if it doesn't, they aren't to blame and get another try later. A Core the owner stopped meanwhile
# is left alone, and its next check after it starts does this.
au_libs_check() { # au_libs_check LOCKFILE_SHA
  local sha="$1" core="$APP_DIR/core" had=0 back
  [ -d "$core/node_modules.old" ] && had=1
  if core_stopped; then
    echo "Jarvis Core isn't running, so the brain's new libraries are checked once it runs again."
    return 0
  fi
  # like every process this check starts: neither lock (a stub-started Core would keep them)
  user_systemctl try-restart "$UNIT_NAME" </dev/null >/dev/null 2>&1 8>&- 9>&-
  if wait_core "${JARVIS_CORE_START_WAIT_SEC:-30}" && core_holds_up; then
    rm -rf "$core/node_modules.old"
    au_unset libs_trying
    au_set last_result "installed the brain's libraries"
    au_log "Installed the brain's libraries; Jarvis Core restarted to load them, and it answers"
    au_event info core.update "Jarvis Core installed the brain's libraries that couldn't be downloaded before, and restarted to load them"
    return 0
  fi
  rm -rf "$core/.npm-install"
  if mv -T "$core/node_modules" "$core/.npm-install" 2>/dev/null; then
    [ "$had" = 1 ] && mv -T "$core/node_modules.old" "$core/node_modules" 2>/dev/null
    rm -rf "$core/.npm-install"
  fi
  au_unset libs_trying
  if [ "$had" = 1 ]; then back="went back to the previous ones"; else back="took them out again"; fi
  user_systemctl try-restart "$UNIT_NAME" </dev/null >/dev/null 2>&1 8>&- 9>&-
  if wait_core "${JARVIS_CORE_START_WAIT_SEC:-30}"; then
    # It answers again without them: these libraries broke it. Not again until a newer version.
    au_set libs_bad "$sha"
    au_set libs_bad_at "$(date +%s)"
    if [ "$had" = 1 ]; then
      au_event warn core.rollback "The brain's new libraries made Jarvis Core fail, so it went back to the previous ones"
    else
      au_event warn core.rollback "The brain's new libraries made Jarvis Core fail, so it took them out again and runs without them"
    fi
    au_set last_result "the brain's new libraries made it fail; $back"
    au_log "The brain's new libraries made Jarvis Core fail: $back, and it answers"
    return 0
  fi
  # Not without them either: something else is wrong, so the libraries aren't blamed; they get another try later
  # (2 hours), and only once the Core answers again.
  au_set libs_failed "$(date +%s)"
  au_unset libs_wait
  au_set last_result "Jarvis Core isn't answering"
  au_event warn core.rollback "Jarvis Core stopped answering after it restarted to load the brain's new libraries, and going back didn't help (jarvis-core logs)"
  au_log "Jarvis Core isn't answering, with the brain's new libraries or without them: $back (jarvis-core logs); they are tried again later"
}

# What the timer runs every 20 minutes. Updates only when GitHub's core/ folder differs from this copy's;
# gives the new version AU_CHECK_SEC seconds, and if it doesn't answer then (or kept restarting), goes back
# to the previous version, refreshes, remembers not to try that one again, and says so in the event log.
cmd_autoupdate_tick() {
  umask 077
  ensure_user_bus
  [ -d "$APP_DIR/.git" ] || {
    echo "Jarvis Core isn't installed in $APP_DIR, so there is nothing to update."
    return 0
  }
  mkdir -p "$STATE_DIR" || return 1
  if have flock; then
    exec 9>"$STATE_DIR/autoupdate.lock"
    flock -n 9 || {
      echo "Another update check is still running."
      return 0
    }
  fi
  au_set last_check "$(date -Is)"
  local branch here there there_rev bad prev prev_short after now_short n0 n1
  branch=$(git -C "$APP_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null) || branch=main
  if ! timeout 120 git -C "$APP_DIR" fetch --quiet origin "$branch" </dev/null >/dev/null 2>&1; then
    au_set last_result "GitHub not reachable"
    echo "Couldn't reach GitHub; the next check is in 20 minutes."
    au_libs_retry # npm's registry is somewhere else; this version's libraries don't wait for GitHub
    return 0
  fi
  here=$(git -C "$APP_DIR" rev-parse -q --verify "HEAD:core" 2>/dev/null) || here=""
  there=$(git -C "$APP_DIR" rev-parse -q --verify "FETCH_HEAD:core" 2>/dev/null) || there=""
  there_rev=$(git -C "$APP_DIR" rev-parse --short FETCH_HEAD 2>/dev/null) || there_rev="?"
  if [ -z "$there" ]; then
    au_set last_result "no core/ on GitHub"
    au_log "GitHub's copy ($there_rev) has no core/ folder; not updating"
    return 0
  fi
  if [ "$here" = "$there" ]; then
    au_set last_result "up to date"
    echo "Up to date: GitHub's core/ is the same as this copy's."
    au_libs_retry
    return 0
  fi
  bad=$(au_get bad_tree) || bad=""
  if [ "$there" = "$bad" ]; then
    au_set last_result "skipped $there_rev (it failed before)"
    echo "Skipping $there_rev: it didn't start properly last time. Waiting for a newer version."
    au_libs_retry # going back may have needed the previous version's libraries
    return 0
  fi
  if [ -n "$(git -C "$APP_DIR" status --porcelain --untracked-files=no 2>/dev/null)" ]; then
    au_set last_result "files changed on this computer"
    au_log "Not updating: files in $APP_DIR were changed on this computer (jarvis-core update --force replaces them)"
    au_libs_retry # this copy's own libraries still get their tries
    return 0
  fi
  prev=$(git -C "$APP_DIR" rev-parse HEAD 2>/dev/null) || return 1
  prev_short=$(git -C "$APP_DIR" rev-parse --short HEAD 2>/dev/null)
  au_log "A new version is on GitHub ($there_rev): updating from $prev_short"
  # The update's refresh tries the libraries itself (and the update's check covers them); if that fails, the next
  # check tries again. A new version also gives libraries that failed with the previous one a new chance.
  au_unset libs_failed libs_wait libs_trying libs_bad libs_bad_at
  export JARVIS_CORE_UNATTENDED=1 # the refresh then leaves the screen's Chrome alone (it reloads itself)
  (cmd_update) </dev/null 9>&- # the lock stays with this check, never with a process it starts
  after=$(git -C "$APP_DIR" rev-parse HEAD 2>/dev/null) || after=""
  if [ "$after" = "$prev" ]; then
    au_set last_result "update failed"
    au_log "The update didn't download; still on $prev_short (the next check is in 20 minutes)"
    return 0
  fi
  now_short=$(git -C "$APP_DIR" rev-parse --short HEAD 2>/dev/null)
  if core_holds_up; then
    au_set last_update "$(date -Is) $prev_short -> $now_short"
    case "$(libs_state)" in
      ok | none)
        au_set last_result "updated to $now_short"
        au_log "Updated to $now_short; it answers"
        au_event info core.update "Jarvis Core updated itself to $now_short (from $prev_short)"
        ;;
      *)
        au_set last_result "updated to $now_short, but its libraries didn't install"
        au_log "Updated to $now_short; it answers, but the brain's libraries didn't install (the next check tries again)"
        au_event info core.update "Jarvis Core updated itself to $now_short (from $prev_short), but couldn't install the brain's libraries yet; it tries again by itself"
        ;;
    esac
    return 0
  fi
  au_log "The new version ($now_short) isn't answering ${AU_CHECK_SEC} seconds after the update: going back to $prev_short"
  au_set bad_tree "$there"
  if ! git -C "$APP_DIR" reset --hard --quiet "$prev" </dev/null; then
    au_set last_result "rollback failed"
    au_log "Couldn't go back to $prev_short (git reset failed). Run: jarvis-core update --force"
    au_event warn core.rollback "An automatic update to $now_short didn't start properly, and going back failed: run jarvis-core update --force"
    return 1
  fi
  JARVIS_CORE_ROLLBACK_FROM="$now_short" bash "$APP_DIR/core/install/install.sh" --refresh </dev/null 9>&-
  if wait_core "${JARVIS_CORE_START_WAIT_SEC:-30}"; then
    au_log "Back on $prev_short, and it answers"
  else
    au_log "Back on $prev_short, but Jarvis Core still isn't answering (jarvis-core logs)"
  fi
  au_set last_rollback "$(date -Is) $now_short -> $prev_short"
  au_set last_result "went back to $prev_short ($now_short didn't start)"
  au_event warn core.rollback "An automatic update to $now_short didn't start properly, so Jarvis Core went back to $prev_short"
  return 0
}

cmd_autoupdate() {
  case "${1:-status}" in
    on | enable) cmd_autoupdate_on ;;
    off | disable) cmd_autoupdate_off ;;
    status) cmd_autoupdate_status ;;
    refresh) cmd_autoupdate_refresh ;;
    print-units)
      printf '%s\n' "# $AU_SERVICE_FILE"
      au_service_content
      printf '%s\n' "# $AU_TIMER_FILE"
      au_timer_content
      ;;
    *)
      echo "Usage: jarvis-core autoupdate on|off|status" >&2
      return 2
      ;;
  esac
}

# ------------------------------------------------------------------------------------------ uninstall

gdm_autologin_off() { # print custom.conf with automatic login turned off for the [daemon] section
  awk '
    /^[ \t]*\[/ { insec = ($0 ~ /^[ \t]*\[daemon\][ \t]*$/); print; if (insec) print "AutomaticLoginEnable=false"; next }
    insec && /^[ \t]*AutomaticLogin(Enable)?[ \t]*=/ { next }
    { print }
  ' "$1"
}

cmd_uninstall() {
  local purge=0 yes=0 arg ans
  for arg in "$@"; do
    case "$arg" in
      --purge) purge=1 ;;
      --yes | -y) yes=1 ;;
    esac
  done
  title "Removing Jarvis Core"
  if [ "$purge" = 1 ]; then
    say "This removes Jarvis Core, its screen, its settings (your Claude key too) AND its history and"
    say "your devices' backups (--purge)."
  else
    say "This removes Jarvis Core and its screen, and puts your screen and login settings back."
    say "Its history, your devices' backups and its settings (your Claude key too) stay in $DATA_DIR"
    say "and $SETTINGS_DIR (add --purge to delete them)."
  fi
  if [ "$yes" != 1 ]; then
    if ! (exec </dev/tty) 2>/dev/null; then
      die "No terminal to confirm in. Run: jarvis-core uninstall --yes"
    fi
    printf '  ? Remove Jarvis Core now? [y/N] '
    IFS= read -r ans </dev/tty || ans=""
    case "$ans" in y | Y | yes | YES | Yes) ;; *)
      say "Nothing was changed."
      return 0
      ;;
    esac
  fi
  ensure_user_bus

  # Automatic updates (also a timer set up by hand under the same names)
  if [ -f "$AU_TIMER_FILE" ] || [ -f "$AU_SERVICE_FILE" ] || [ -f "$AU_OLD_SCRIPT" ] || au_enabled; then
    user_systemctl disable --now --quiet "$AU_TIMER" >/dev/null 2>&1 || true
    user_systemctl stop "$AU_SERVICE" >/dev/null 2>&1 || true
    rm -f "$AU_TIMER_FILE" "$AU_SERVICE_FILE" "$AU_OLD_SCRIPT"
    user_systemctl daemon-reload 2>/dev/null || true
    ok "Stopped the automatic updates and removed their timer"
  fi

  # The service
  if [ -f "$UNIT_FILE" ] || user_systemctl is-enabled "$UNIT_NAME" >/dev/null 2>&1; then
    user_systemctl disable --now "$UNIT_NAME" >/dev/null 2>&1 || true
    rm -f "$UNIT_FILE"
    user_systemctl daemon-reload 2>/dev/null || true
    ok "Stopped the Jarvis Core service and removed it"
  fi

  # The screen
  stop_screen
  if [ -f "$AUTOSTART_FILE" ]; then
    rm -f "$AUTOSTART_FILE"
    ok "The dashboard no longer starts at login"
  fi

  # Screen blanking, lock and suspend: back to what they were
  if have gsettings && [ -f "$STATE_DIR/gsettings-before" ]; then
    local schema key value restored=0
    while IFS=$'\t' read -r schema key value; do
      [ -n "$schema" ] && [ -n "$key" ] || continue
      if [ -n "$value" ]; then
        gsettings set "$schema" "$key" "$value" 2>/dev/null && restored=$((restored + 1))
      else
        gsettings reset "$schema" "$key" 2>/dev/null && restored=$((restored + 1))
      fi
    done <"$STATE_DIR/gsettings-before"
    ok "Screen blanking, lock and sleep settings put back ($restored settings)"
  fi

  # Things that need the password: automatic login, the disk-check permission, Tailscale serve,
  # the command shortcut, lingering.
  local need_root=0
  [ "$(state_get autologin 2>/dev/null)" = enabled-by-installer ] && need_root=1
  smart_rule_present && need_root=1
  [ -e "$SHIM" ] && need_root=1
  ts_load || true
  ts_serving && need_root=1
  if [ "$need_root" = 1 ] && ! need_sudo; then
    note "Without your password I can't undo these; run them yourself:"
    [ "$(state_get autologin 2>/dev/null)" = enabled-by-installer ] && say "  turn off automatic login in Settings > System > Users"
    smart_rule_present && say "  sudo rm $SUDOERS_FILE"
    ts_serving && say "  sudo tailscale serve --https=443 off"
    [ -e "$SHIM" ] && say "  sudo rm $SHIM"
  elif [ "$need_root" = 1 ]; then
    if [ "$(state_get autologin 2>/dev/null)" = enabled-by-installer ] && [ -f "$GDM_CONF" ]; then
      local tmp
      tmp=$(mktemp)
      if gdm_autologin_off "$GDM_CONF" >"$tmp" && as_root install -m 0644 "$tmp" "$GDM_CONF"; then
        ok "Automatic login is off again (from the next restart)"
      else
        note "Couldn't turn automatic login off: use Settings > System > Users > Automatic Login"
      fi
      rm -f "$tmp"
    fi
    if smart_rule_present; then
      if as_root rm -f "$SUDOERS_FILE"; then ok "Removed the disk-check permission"; else note "Couldn't remove it: sudo rm $SUDOERS_FILE"; fi
    fi
    if ts_serving; then
      if as_root "$TS_BIN" serve --https=443 off >/dev/null 2>&1 && ! ts_serving; then
        ok "Tailscale no longer passes Jarvis Core to your devices"
      else
        note "Couldn't turn off Tailscale's sharing: run sudo tailscale serve --https=443 off"
      fi
    fi
    if [ -e "$SHIM" ]; then
      if as_root rm -f "$SHIM"; then ok "Removed $SHIM"; else note "Couldn't remove it: sudo rm $SHIM"; fi
    fi
  fi
  if [ "$(state_get linger 2>/dev/null)" = enabled-by-installer ]; then
    loginctl disable-linger "$(id -un)" 2>/dev/null || { need_sudo && as_root loginctl disable-linger "$(id -un)"; } || true
  fi

  # The program itself
  if [ -d "$APP_DIR/.git" ]; then
    if [ -n "$(git -C "$APP_DIR" status --porcelain --untracked-files=no 2>/dev/null)" ]; then
      note "Kept $APP_DIR because files in it were changed on this computer"
    else
      rm -rf "$APP_DIR" && ok "Removed $APP_DIR"
    fi
  fi
  rm -rf "$STATE_DIR"
  if [ "$purge" = 1 ]; then
    rm -rf "$DATA_DIR" "$SETTINGS_DIR" "$PROFILE_DIR"
    ok "Deleted the history, the backups, the settings, the key and the screen's Chrome profile"
  fi
  rm -f "$SELF_BIN"
  ok "Removed the jarvis-core command"
  printf '\n  %sJarvis Core is uninstalled.%s Tailscale, Chrome and Node.js stay installed.\n' "$B" "$N"
}

# ------------------------------------------------------------------------------------------ main

usage() {
  cat <<EOF
${B}jarvis-core${N}: look after Jarvis Core, the home base's 24/7 system report.

  jarvis-core status               is it running, is everything OK, which addresses
  jarvis-core url                  the address to paste into Jarvis on the iPhone and the Mac
  jarvis-core update               download the latest version, restart, reload the screen
  jarvis-core restart              restart the Core (the screen reconnects by itself)
  jarvis-core logs [-f]            the Core's recent log (-f: keep following it)
  jarvis-core open                 (re)start the full-screen dashboard on this screen
  jarvis-core autoupdate on|off|status   keep Jarvis Core up to date by itself (every 20 minutes)
  jarvis-core uninstall [--purge]  remove Jarvis Core (keeps its history unless --purge)
EOF
}

main() {
  if [ "$(id -u)" = 0 ] && [ -z "${JARVIS_CORE_ALLOW_ROOT:-}" ]; then
    die "Run jarvis-core as yourself, without sudo."
  fi
  SELF_PATH=$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null) || SELF_PATH="$SELF_BIN"
  local cmd="${1:-help}"
  [ $# -gt 0 ] && shift
  case "$cmd" in
    status) cmd_status "$@" ;;
    url) cmd_url "$@" ;;
    update) cmd_update "$@" ;;
    restart) cmd_restart "$@" ;;
    logs | log) cmd_logs "$@" ;;
    open) cmd_open "$@" ;;
    screen) cmd_screen "$@" ;;
    autoupdate | auto-update) cmd_autoupdate "$@" ;;
    autoupdate-tick) cmd_autoupdate_tick "$@" ;;
    uninstall | remove) cmd_uninstall "$@" ;;
    help | -h | --help) usage ;;
    version | --version) git -C "$APP_DIR" log -1 --format='%h %cd' --date=short 2>/dev/null || echo unknown ;;
    *)
      usage
      return 2
      ;;
  esac
}

# The whole file is read before anything runs, so `update` can safely replace it.
main "$@"
exit $?
