{
  "name": "jarvis-core",
  "version": "1.2.1",
  "private": true,
  "description": "Jarvis Core: the home base. System report (collector, health rules, history, events, a JSON API with live updates, a small local status assistant) on Node built-ins only, plus the brain (background research, watchers, morning briefing, push, sync) and the senses (opt-in hearing and voice for the phone, on this computer's CPU), whose dependencies are loaded lazily.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/main.mjs",
    "fixture": "node server/main.mjs --fixture ok",
    "once": "node server/main.mjs --once",
    "test": "JARVIS_CORE_LONGRUN_HOURS=6 node --test \"test/**/*.test.mjs\" \"dashboard/test/*.test.mjs\" \"install/test/*.test.mjs\"",
    "test:server": "JARVIS_CORE_LONGRUN_HOURS=6 node --test \"test/server/**/*.test.mjs\"",
    "test:dashboard": "node --test \"dashboard/test/*.test.mjs\"",
    "test:install": "node --test \"install/test/*.test.mjs\"",
    "test:longrun": "JARVIS_CORE_LONGRUN_HOURS=24 node --test test/server/longrun.test.mjs",
    "test:senses": "NODE_USE_ENV_PROXY=1 node --test test/online/senses.online.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.10.0",
    "@huggingface/transformers": "3.8.1",
    "kokoro-js": "1.2.1",
    "web-push": "3.6.7"
  }
}
