{
  "name": "jarvis-core",
  "version": "1.0.0",
  "private": true,
  "description": "Jarvis Core: the home base's 24/7 system report. Collector, health rules, history, events, a JSON API with live updates, and a small local status assistant. Node built-ins only.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/main.mjs",
    "fixture": "node server/main.mjs --fixture ok",
    "once": "node server/main.mjs --once",
    "test": "JARVIS_CORE_LONGRUN_HOURS=6 node --test \"test/server/**/*.test.mjs\" \"dashboard/test/*.test.mjs\" \"install/test/*.test.mjs\"",
    "test:server": "JARVIS_CORE_LONGRUN_HOURS=6 node --test \"test/server/**/*.test.mjs\"",
    "test:dashboard": "node --test \"dashboard/test/*.test.mjs\"",
    "test:install": "node --test \"install/test/*.test.mjs\"",
    "test:longrun": "JARVIS_CORE_LONGRUN_HOURS=24 node --test test/server/longrun.test.mjs"
  }
}
