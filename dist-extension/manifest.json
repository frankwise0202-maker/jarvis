{
  "manifest_version": 3,
  "name": "Jarvis for Chrome",
  "short_name": "Jarvis",
  "version": "1.0.0",
  "description": "Jarvis works in your own Chrome tabs: it reads pages, clicks and types for you, and asks before anything that matters.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Jarvis",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "debugger",
    "tabs",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+J",
        "mac": "Alt+Shift+J"
      },
      "description": "Open Jarvis"
    },
    "stop-jarvis": {
      "suggested_key": {
        "default": "Ctrl+Shift+Period",
        "mac": "Command+Shift+Period"
      },
      "description": "Stop Jarvis right away"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; connect-src https://api.anthropic.com; img-src 'self' data:; media-src 'none'; style-src 'self'; font-src 'self'"
  }
}
