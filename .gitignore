# Dependencies
node_modules/

# Build output (npm run build) and the temporary GitHub Pages checkout (npm run deploy)
dist/
.gh-pages-worktree/

# E2E screenshots and failure reports (npm run e2e)
test/artifacts/

# Logs, editor and OS clutter
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Local secrets (Jarvis never needs them in the repo: the API key lives in the browser)
.env
.env.*

# Stray tool downloads (never part of Jarvis)
*.whl

# The natural voice's model files (scripts/fetch-voice-model.mjs puts them here at deploy time)
vendor/
